# Copy to repo root as `.env` on the production server:
#   cp deploy/.env.production.example .env
#
# Fill every CHANGE_ME value from /var/www/mrchamedonBeta/.env (Laravel).

PORT=8080
GIN_MODE=release

# Dedicated geo Redis (do NOT reuse mrchamedon-redis — session/cache keys would collide).
REDIS_ADDR=mrchamedon-geo-redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Optional PostGIS for GPS history / internal road graph.
# Leave empty until you import OSM road data. Service starts without it.
POSTGRES_DSN=

# Routing — start without OSRM; enable after map preprocessing (see docs/DEPLOY.fa.md).
ROUTING_BACKEND=internal
OSRM_BASE_URL=http://mrchamedon-osrm:5000
ROUTING_TIMEOUT_MS=30000
ROUTING_MAX_IN_FLIGHT=100
INTERNAL_ROUTING_MAX_IN_FLIGHT=4
OSRM_ROUTING_MAX_IN_FLIGHT=100
ROUTING_QUEUE_TIMEOUT_MS=1000
ROUTING_YEN_SPUR_CAP=60
ROUTING_MAX_ALTERNATIVES=1
ROUTE_CACHE_PRECISION=5
INTERNAL_GRAPH_ENABLED=false
INTERNAL_GRAPH_LAZY_LOAD=false
INTERNAL_GRAPH_REQUIRED=false
AVG_SPEED_KMH=40

GPS_RATE_LIMIT_MS=3000
DEVIATION_THRESH_KM=0.05
BATCH_SIZE=500
BATCH_FLUSH_SEC=2

# Laravel PostgreSQL — same DB as MrchamedonBeta (read-only user recommended).
SHIPMENT_DB_DRIVER=postgres
SHIPMENT_DB_DSN=host=mrchamedon-postgres port=5432 user=CHANGE_ME password=CHANGE_ME dbname=CHANGE_ME sslmode=disable
SHIPMENT_TABLE=shipments
SHIPMENT_ORIGIN_LOCATION_COLUMN=start_location
SHIPMENT_END_LOCATION_COLUMN=end_location
SHIPMENT_SEARCH_RADIUS_KM=2
SHIPMENT_SEARCH_LIMIT=100

VEHICLE_TYPES_TABLE=vehicle_types
VEHICLE_TYPE_LABEL_COLUMN=title
VEHICLE_TYPE_TITLE_COLUMN=title

CONTENT_TYPES_TABLE=content_types
CONTENT_TYPE_ID_COLUMN=content_type_id
CONTENT_TYPE_IMAGE_COLUMN=image

SHIPMENT_IMAGES_TABLE=shipment_images
SHIPMENT_IMAGE_SHIPMENT_ID_COLUMN=shipment_id
SHIPMENT_IMAGE_COLUMN=image

DRIVER_GEO_KEY=drivers:geo
DRIVER_LOCATION_STREAM_KEY=driver:locations:stream
DRIVER_SEARCH_RADIUS_KM=20

# Must match Laravel JWT_SECRET exactly.
JWT_AUTH_ENABLED=true
JWT_SECRET=CHANGE_ME
JWT_ALGO=HS256

# Production domains:
#   nurpa.ir           = frontend
#   testmrchamedon.ir  = Laravel API
#   norpa.ir           = geo-service
CORS_ALLOWED_ORIGINS=https://nurpa.ir,https://www.nurpa.ir

WEBSOCKET_AUTH_ENABLED=true
WS_SHIPMENT_REQUIRE_TLS=true
WS_SHIPMENT_AUTH_REQUIRED=true
WS_SHIPMENT_LEGACY_FORMAT=true

API_KEY_ENABLED=false
API_KEY=

RATE_LIMIT_PER_MINUTE=300
REQUEST_BODY_LIMIT_BYTES=1048576
