# Add this file to the frontend gateway nginx conf.d directory on the server:
#   /var/www/mrchamedonBetaFront/MrChamedonBetaFrontend/nginx/conf.d/geo.conf
#
# DNS: create an A record  geo.nurpa.ir  -> server IP
# SSL: use the same certbot flow as other nurpa.ir vhosts.

server {
    listen 80;
    listen [::]:80;
    server_name geo.nurpa.ir;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name geo.nurpa.ir;

    ssl_certificate     /etc/letsencrypt/live/geo.nurpa.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/geo.nurpa.ir/privkey.pem;

    location / {
        proxy_pass http://mrchamedon-geo-service:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
}
