# Gateway config for Go geo-service on domain: norpa.ir
# Copy to:
#   /var/www/mrchamedonBetaFront/mrchamedonBeta_front/nginx/conf.d/norpa.conf
#
# Domains:
#   nurpa.ir           → frontend
#   testmrchamedon.ir  → Laravel backend
#   norpa.ir           → geo-service (this file)

server {
    listen 80;
    listen [::]:80;
    server_name norpa.ir www.norpa.ir;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name norpa.ir www.norpa.ir;

    ssl_certificate     /etc/letsencrypt/live/norpa.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/norpa.ir/privkey.pem;

    location / {
        proxy_pass http://mrchamedon-geo-service:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # WebSocket
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
}
